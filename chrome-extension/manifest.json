{
  "manifest_version": 3,
  "name": "Textarea Sync",
  "description": "Save your latest textarea.my document locally and share it across devices with Pastebin.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://textarea.my/*", "https://pastebin.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open latest Textarea",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://textarea.my/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
