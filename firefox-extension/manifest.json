{
  "manifest_version": 3,
  "name": "Textarea Sync",
  "description": "Save and share named textarea.my documents across devices with GitHub Gists.",
  "version": "0.1.16",
  "permissions": ["storage"],
  "host_permissions": ["https://textarea.my/*", "https://api.github.com/*"],
  "background": {
    "scripts": ["document-storage.js", "gist.js", "background.js"]
  },
  "action": {
    "default_title": "Open latest Textarea",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://textarea.my/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "textarea-sync@textarea.my",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
